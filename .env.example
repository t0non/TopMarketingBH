# =====================================================
# TOP MARKETING BH — Variáveis de Ambiente
# Renomeie para .env.local para desenvolvimento local
# Configure em: Vercel > Settings > Environment Variables
# =====================================================

# ─────────────────────────────────────────────────────
# GOOGLE SHEETS WEBHOOK
# Como obter:
#   1. Abra o Google Sheets e vá em Extensões > Apps Script
#   2. Cole o script do webhook (fornecido separadamente)
#   3. Publique como Web App (acesso: Qualquer pessoa)
#   4. Copie a URL gerada aqui
# ─────────────────────────────────────────────────────
GOOGLE_SHEETS_WEBHOOK_URL=

# ─────────────────────────────────────────────────────
# SUPABASE
# Como obter:
#   1. Acesse https://supabase.com e crie um projeto
#   2. Vá em Settings > API
#   3. URL: copie o "Project URL"
#   4. SERVICE_ROLE_KEY: copie a chave "service_role" (NUNCA expor no frontend)
#
# ATENÇÃO: Use APENAS a service role key no backend.
#          Não use a anon key para salvar leads.
# ─────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────
# META (FACEBOOK / INSTAGRAM) ADS
# Como obter:
#   META_PIXEL_ID:
#     Events Manager > selecione seu Pixel > ID no topo
#   META_ACCESS_TOKEN:
#     Events Manager > seu Pixel > Configurações > Conversions API
#     > Gerar token de acesso (token do sistema ou permanente)
#   META_TEST_EVENT_CODE (opcional):
#     Events Manager > Test Events > o código TEST1234...
#     REMOVA ou deixe em branco em produção
# ─────────────────────────────────────────────────────
META_PIXEL_ID=
META_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

# ─────────────────────────────────────────────────────
# ADMINISTRAÇÃO (API de atualização de status de leads)
# Defina uma senha secreta aleatória. Exemplo:
#   openssl rand -hex 32
# Use no header: x-admin-secret: <valor>
# ─────────────────────────────────────────────────────
ADMIN_SECRET=

# ─────────────────────────────────────────────────────
# GOOGLE ADS — Configurar SOMENTE via GTM
# NÃO coloque Conversion ID nem Label aqui.
# Esses valores vão APENAS nas tags do Google Tag Manager.
# ─────────────────────────────────────────────────────
# GTM_CONTAINER_ID=GTM-XXXXXXX  ← colocar direto no HTML
